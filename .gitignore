/extracted/

# PlayStation disc images (your own copy of the game, never committed).
# The repository has no legitimate .bin files: the game's text tables
# (gtext.bin...) are copyrighted too.
/HogsOfWar/
*.bin
*.BIN
*.cue
*.iso
*.chd

# Language packs generated by openhogs-langpack from your disc
# (copyrighted data). The template and hand-written translations stay.
/content/packs/lang-*/

# Local configuration (copied from config/openhogs.default.ini)
/config/openhogs.ini
